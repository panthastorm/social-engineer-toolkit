{
  "mcpServers": {
    "darknet": {
      "command": "npx",
      "args": ["-y", "darknet-mcp-server"],
      "env": {
        "HIBP_API_KEY": "${HIBP_API_KEY}",
        "INTELX_API_KEY": "${INTELX_API_KEY}",
        "OTX_API_KEY": "${OTX_API_KEY}",
        "ABUSEIPDB_API_KEY": "${ABUSEIPDB_API_KEY}",
        "ABUSECH_AUTH_KEY": "${ABUSECH_AUTH_KEY}",
        "PULSEDIVE_API_KEY": "${PULSEDIVE_API_KEY}",
        "HUDSONROCK_API_KEY": "${HUDSONROCK_API_KEY}",
        "VULNERS_API_KEY": "${VULNERS_API_KEY}",
        "HYBRID_API_KEY": "${HYBRID_API_KEY}",
        "PHISHTANK_API_KEY": "${PHISHTANK_API_KEY}",
        "TOR_SOCKS_HOST": "${TOR_SOCKS_HOST:-127.0.0.1}",
        "TOR_SOCKS_PORT": "${TOR_SOCKS_PORT:-9050}"
      }
    }
  }
}
